{
    "name": "paragon/gold-bot",
    "description": "Gold Bot — intelligent XAU/USD market analysis and trading-signal platform",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "comment": "ADR-02. The kernel lives at packages/php-core so that it can be split into its own private repository with `git subtree split` without rewriting a single import. Swapping this entry for a `vcs` repository and a version constraint is then the whole migration — see packages/php-core/README.md.",
            "type": "path",
            "url": "packages/php-core",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "paragon/php-core": "@dev",
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-sodium": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "GoldBot\\": "app/",
            "GoldBot\\Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GoldBot\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "migrate": "php cron/run.php migrate"
    }
}
