# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
/vendor/
/node_modules/
# The kernel only grows a vendor/ when it is installed standalone (ADR-02).
# Its composer.lock is ignored for the same reason a library's always is: the
# consuming application's lock is the one that decides versions.
/packages/php-core/vendor/
/packages/php-core/composer.lock

# Runtime storage (see docs/03) — directories tracked, contents ignored
/storage/logs/*
/storage/cache/*
/storage/backups/*
/storage/locks/*
/storage/tmp/*
!/storage/**/.gitignore

# Test & tooling artefacts
/.phpunit.cache/
/packages/php-core/.phpunit.cache/
.phpunit.result.cache
/coverage/

# Editor & OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
