# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
/vendor/
/node_modules/

# Runtime storage (see docs/03) — directories tracked, contents ignored
/storage/logs/*
/storage/cache/*
/storage/backups/*
/storage/locks/*
/storage/tmp/*
!/storage/**/.gitignore

# Test & tooling artefacts
/.phpunit.cache/
.phpunit.result.cache
/coverage/

# Editor & OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
