<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true"
         colors="true">
    <testsuites>
        <!--
            Unit: pure domain logic. No database, no network, no clock.

            The kernel's own tests run here rather than only under the package's
            phpunit.xml. paragon/php-core is consumed as a path repository
            (ADR-02), so a kernel change lands in this working tree and must
            break this run — not one somebody remembers to do separately. When
            the package moves to its own repository, drop the second directory:
            Gold Bot pins a version at that point, and the kernel is tested
            where it lives.
        -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <directory>packages/php-core/tests</directory>
        </testsuite>
        <!-- Integration: repositories, migrations, ingest. Needs a test database. -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!-- Feature: HTTP routes, auth, RBAC, CSRF. -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>app</directory>
            <directory>packages/php-core/src</directory>
        </include>
    </source>
</phpunit>
