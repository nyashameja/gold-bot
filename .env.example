# Gold Bot — environment configuration
#
# Copy to .env and fill in. NEVER commit .env.
# This file must sit ABOVE the Apache document root (document root is public/).

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Gold Bot"
APP_ENV=production            # local | production
APP_DEBUG=false               # NEVER true in production — leaks stack traces
APP_URL=https://goldbot.example.com
APP_TIMEZONE=UTC              # Storage is always UTC; display tz is per-user

# 32-byte key, base64 encoded. Generate with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Encrypts API tokens at rest. Rotating it invalidates every stored token.
APP_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paragon_goldbot
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Twelve Data — market data ────────────────────────────────────────────────
# https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
# Budget gate (document 01, §5). Set to your plan's real limits — the gate
# defers work rather than spending beyond these.
TWELVE_DATA_DAILY_LIMIT=800
TWELVE_DATA_PER_MINUTE_LIMIT=8

# ── Economic calendar (ADR-12) ───────────────────────────────────────────────
# ForexFactory weekly feed — primary. Free, no authentication.
FOREX_FACTORY_BASE_URL=https://nfs.faireconomy.media
FOREX_FACTORY_ENABLED=true

# FRED — corroborating source for US releases. Free key:
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
FRED_ENABLED=true

# Trading Economics — optional paid upgrade. Leave disabled unless subscribed.
TRADING_ECONOMICS_ENABLED=false
TRADING_ECONOMICS_API_KEY=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Token from @BotFather. Stored encrypted once configured in the UI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BASE_URL=https://api.telegram.org
# Operational alerts go here, separate from the signal channel (document 01, §11)
TELEGRAM_ALERT_CHAT_ID=

# ── Session & security ───────────────────────────────────────────────────────
SESSION_NAME=goldbot_session
SESSION_LIFETIME_MINUTES=120
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_SECURE_COOKIE=true    # Requires HTTPS. Only false for local http://.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Logging & cache ──────────────────────────────────────────────────────────
LOG_LEVEL=info                # debug | info | notice | warning | error | critical
LOG_CHANNEL=file
CACHE_DRIVER=apcu             # apcu | file — falls back to file if APCu is absent

# ── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret guarding any HTTP-triggered task runner. CLI invocation of
# cron/run.php does not use it.
CRON_SECRET=
