# Root-level deny-all. The Apache document root must point at public/.
# This is the second line of defence for the case where it does not —
# the misconfiguration that would otherwise expose .env (docs/03, §1).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
